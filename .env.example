SERVER_NAME=My Valheim Server
SERVER_WORLD=Dedicated
SERVER_PASSWORD=replace-with-at-least-five-characters
SERVER_PORT=2456
SERVER_QUERY_PORT=2457
SERVER_EXTRA_PORT=2458
SERVER_PUBLIC=1
SERVER_CROSSPLAY=false
SERVER_INSTANCE_ID=
SERVER_SAVE_INTERVAL=1800
SERVER_BACKUPS=4
SERVER_BACKUP_SHORT=7200
SERVER_BACKUP_LONG=43200
SERVER_MAX_PLAYERS=10

# When enabled, these are applied to the world at every server start.
SERVER_MANAGE_WORLD_MODIFIERS=false
SERVER_PRESET=normal
SERVER_MODIFIER_COMBAT=
SERVER_MODIFIER_DEATH_PENALTY=
SERVER_MODIFIER_RESOURCES=
SERVER_MODIFIER_RAIDS=
SERVER_MODIFIER_PORTALS=
SERVER_SETKEY_NO_BUILD_COST=false
SERVER_SETKEY_PLAYER_EVENTS=false
SERVER_SETKEY_PASSIVE_MOBS=false
SERVER_SETKEY_NO_MAP=false
VSM_HTTP_PORT=8080
VSM_PUBLIC_URL=http://SERVER_IP:8080
# Optional: show Steam names and avatars in the admin dashboard.
VSM_STEAM_API_KEY=
VSM_UPDATE_ON_START=true
VSM_UPDATE_REPOSITORY=monokaijs/valheim-server-manager
# Server-owned characters are optional; inventory inspection is always required.
VSM_SERVER_CHARACTERS_ENABLED=false
VSM_SERVER_CHARACTERS_ACCEPT_FIRST_JOIN=true
VSM_SERVER_CHARACTERS_REJECT_USED=false
VSM_SERVER_CHARACTERS_BACKUPS=10
VSM_CLIENT_MOD_GRACE_SECONDS=20
# VSM_IMAGE is maintained automatically after the first dashboard self-update.
