SERVER_NAME=My Valheim Server
SERVER_WORLD=Dedicated
SERVER_PASSWORD=replace-with-at-least-five-characters
SERVER_PORT=2456
SERVER_QUERY_PORT=2457
SERVER_EXTRA_PORT=2458
SERVER_PUBLIC=1
SERVER_CROSSPLAY=false
VSM_HTTP_PORT=8080
VSM_PUBLIC_URL=http://SERVER_IP:8080
VSM_UPDATE_ON_START=true
VSM_UPDATE_REPOSITORY=monokaijs/valheim-server-manager
# Default compatibility mode: vanilla clients can join and keep their own characters.
VSM_SERVER_CHARACTERS_ENABLED=false
VSM_SERVER_CHARACTERS_ACCEPT_FIRST_JOIN=true
VSM_SERVER_CHARACTERS_REJECT_USED=false
VSM_SERVER_CHARACTERS_BACKUPS=10
VSM_CLIENT_MOD_GRACE_SECONDS=20
# VSM_IMAGE is maintained automatically after the first dashboard self-update.
