<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ValheimServerManagerRuntimeUpdater</AssemblyName>
    <RootNamespace>ValheimServerManager.RuntimeUpdater</RootNamespace>
    <Version>2.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">$(VALHEIM_MANAGED)</ValheimManaged>
    <BepInExRoot Condition="'$(BepInExRoot)' == ''">$(BEPINEX_ROOT)</BepInExRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Compile Include="../Shared/ClientNotice.cs" Link="ClientSupport/ClientNotice.cs" />
    <Compile Include="../Shared/NoticeOverlay.cs" Link="ClientSupport/NoticeOverlay.cs" />
    <Compile Include="../Shared/NoticeInputGuard.cs" Link="ClientSupport/NoticeInputGuard.cs" />
    <ProjectReference Include="../ValheimServerManager.Bootstrap/ValheimServerManager.Bootstrap.csproj" Private="false" />
    <Reference Include="BepInEx"><HintPath>$(BepInExRoot)/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExRoot)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ValheimManaged)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ValheimManaged)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DoNotCopyGameAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'UnityEngine'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'ValheimServerManagerBootstrap'" />
    </ItemGroup>
  </Target>
  <Target Name="VerifyGameReferences" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(ValheimManaged)/UnityEngine.dll')" Text="Set ValheimManaged to the current valheim_server_Data/Managed directory." />
    <Error Condition="!Exists('$(BepInExRoot)/core/BepInEx.dll')" Text="Set BepInExRoot to the current BepInEx directory." />
  </Target>
</Project>
