<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ValheimServerManager.Server</AssemblyName>
    <RootNamespace>ValheimServerManager.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">$(VALHEIM_MANAGED)</ValheimManaged>
    <BepInExRoot Condition="'$(BepInExRoot)' == ''">$(BEPINEX_ROOT)</BepInExRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ConnectionPolicy.cs" Link="ServerSupport/ConnectionPolicy.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExRoot)/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExRoot)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ValheimManaged)/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ValheimManaged)/assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="VerifyGameReferences" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(ValheimManaged)/assembly_valheim.dll')" Text="Set ValheimManaged to the current valheim_server_Data/Managed directory." />
    <Error Condition="!Exists('$(BepInExRoot)/core/BepInEx.dll')" Text="Set BepInExRoot to the current BepInEx directory." />
  </Target>
</Project>
